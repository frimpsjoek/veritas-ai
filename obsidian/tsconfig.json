{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2020"], "types": ["node"], "skipLibCheck": true, "isolatedModules": true,
    "allowJs": true, "checkJs": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
